# Database configuration
# Supabase hosted PostgreSQL connection string (session pooler recommended for IPv4 compatibility)
DATABASE_URL=postgresql://postgres.<your-project-ref>:<your-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Separate throwaway database used strictly for automated test suites
TEST_DATABASE_URL=postgresql://postgres.<your-test-project-ref>:<your-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Cryptographic secret for signing HS256 JWT tokens (min 32 random characters)
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters

# Token lifetime in minutes (default: 60)
JWT_EXPIRE_MINUTES=60

# Background Worker Embedding Generation (default: false)
# Set to true to enable atomic embedding job enqueuing and processing for duplicate detection
ENABLE_EMBEDDINGS=false
